# Este repo se guarda SIEMPRE con LF. Sin esto, con core.autocrlf=true en
# Windows los .sh se sacan con CRLF y `bash` revienta -- y encima corren
# dentro de contenedores Linux (docker-compose.full.yml, CI).
* text=auto eol=lf

# Explícitos donde un CRLF rompe la ejecución:
*.sh        text eol=lf
*.bash      text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.sql       text eol=lf

# Binarios: git no los toca.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
