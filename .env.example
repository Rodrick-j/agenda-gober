# Copia este archivo a .env y cambia TODOS los valores. .env nunca se commitea.

# --- Postgres: superusuario (solo administración/migraciones) ---
POSTGRES_USER=agenda_admin
POSTGRES_PASSWORD=changeme_dev_only
POSTGRES_DB=agenda_gober
POSTGRES_PORT=5433
# (5432 se dejó libre a propósito: en esta máquina ya hay un Postgres nativo
# corriendo como servicio de Windows — usa 5433 para el contenedor Docker)

# --- Rol de aplicación: el que usa el backend en el día a día ---
# Nunca es superusuario, nunca tiene BYPASSRLS — así las políticas RLS
# se aplican de verdad y no se pueden saltar por accidente.
APP_DB_USER=app_user
APP_DB_PASSWORD=changeme_dev_only_too

# --- Backend / API ---
# Secreto de firma del JWT. Genera uno propio, NO uses este:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=changeme_genera_uno_de_verdad

# --- Stack completo en Docker (infra/docker/docker-compose.full.yml) ---
# Único origen al que CORS le deja mandar la cookie httpOnly del login.
WEB_ORIGIN=http://localhost:3002
# URL de la API que el frontend hornea en el bundle del cliente en build-time.
NEXT_PUBLIC_API_URL=http://localhost:3001
# true = el servicio `migrate` también carga db/seeds/ (solo dev/demo).
RUN_SEEDS=false
