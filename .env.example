# Copia este archivo a .env y cambia las contraseñas. .env nunca se commitea.

# Credenciales de superusuario de Postgres (solo para administración/migraciones)
POSTGRES_USER=agenda_admin
POSTGRES_PASSWORD=changeme_dev_only
POSTGRES_DB=agenda_gober
POSTGRES_PORT=5433
# (5432 se dejó libre a propósito: en esta máquina ya hay un Postgres nativo
# corriendo como servicio de Windows — usa 5433 para el contenedor Docker)

# Rol de aplicación: el que usará el backend en el día a día.
# Nunca es superusuario, nunca tiene BYPASSRLS — así las políticas RLS
# se aplican de verdad y no se pueden saltar por accidente.
APP_DB_USER=app_user
APP_DB_PASSWORD=changeme_dev_only_too
