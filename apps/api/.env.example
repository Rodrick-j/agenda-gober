# Debe usar el rol de aplicación (app_user), nunca el superusuario.
# Los valores reales viven en ../../.env (APP_DB_USER / APP_DB_PASSWORD / POSTGRES_PORT).
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=agenda_gober
DB_USER=app_user
DB_PASSWORD=changeme
PORT=3001
# Secreto de firma del JWT. La API NO arranca si es de ejemplo o < 32 chars.
# Generalo con: bash scripts/gen-secrets.sh   (usa el mismo valor que ../../.env)
# O dejalo vacío y montá JWT_SECRET_FILE (Docker/K8s secrets). Ver docs/SECRETS.md.
JWT_SECRET=changeme
# Uno o varios orígenes (coma-separados) a los que CORS deja mandar la cookie
# httpOnly del login. Ej: http://localhost:3002,https://agenda.oruro.gob.bo
WEB_ORIGIN=http://localhost:3002
# Coste de bcrypt para hashes nuevos (10-15). Default 12 si se omite.
BCRYPT_ROUNDS=12

# --- Observabilidad (opcional) ---
# DSN del proyecto en sentry.io. Vacío = Sentry apagado, la app corre igual.
SENTRY_DSN=
# Fracción de requests con traza de performance (0 a 1). 0.1 = 10%.
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Sesiones / tokens ---
# Duración del access token (formato de vercel/ms: 15m, 1h...). Corto a propósito.
JWT_ACCESS_TTL=15m
# Días de vida del refresh token / la sesión.
JWT_REFRESH_TTL_DAYS=30
