# Debe usar el rol de aplicación (app_user), nunca el superusuario.
# Los valores reales viven en ../../.env (APP_DB_USER / APP_DB_PASSWORD / POSTGRES_PORT).
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=agenda_gober
DB_USER=app_user
DB_PASSWORD=changeme
PORT=3001
# Genera uno propio: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=changeme
# Único origen al que CORS le permite mandar la cookie httpOnly del login.
WEB_ORIGIN=http://localhost:3002
